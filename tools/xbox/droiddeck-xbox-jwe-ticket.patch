+//! Public synthetic data only, no account, keyring or network access.
+use super::Token;
+use crate::models::soap;
+use base64::{Engine, engine::general_purpose::URL_SAFE_NO_PAD};
+use serde_json::json;
+
+fn jwe(header: serde_json::Value, encrypted_key: &str) -> String {
+    format!("{}.{}.{}.{}.{}", URL_SAFE_NO_PAD.encode(header.to_string()), encrypted_key,
+        URL_SAFE_NO_PAD.encode(b"synthetic-iv"), URL_SAFE_NO_PAD.encode(b"synthetic-ciphertext"),
+        URL_SAFE_NO_PAD.encode(b"synthetic-tag"))
+}
+
+fn delegation(raw: &str) -> Token {
+    let response: soap::RequestSecurityTokenResponse = serde_json::from_value(json!({
+        "TokenType":"urn:passport:delegationcompact",
+        "AppliesTo":{"EndpointReference":{"Address":"www.microsoft.com"}},
+        "Lifetime":{"Created":"2026-10-22T00:00:00Z","Expires":"2026-10-23T00:00:00Z"},
+        "RequestedSecurityToken":{"BinarySecurityToken":{"@Id":"fixture","$value":raw}}
+    })).unwrap();
+    Token::from(response)
+}
+
+#[test]
+fn delegation_ticket_jwe_uses_t_prefix_without_rewriting_payload() {
+    for raw in [jwe(json!({"alg":"dir","enc":"A256GCM"}), ""),
+        jwe(json!({"alg":"RSA-OAEP-256","enc":"A256GCM"}), "a2V5")] {
+        assert!(matches!(delegation(&raw), Token::Compact(value) if value == format!("t={raw}")));
+    }
+}
+
+#[test]
+fn delegation_ticket_opaque_and_signed_tokens_keep_d_prefix() {
+    for raw in ["", "opaque", "EwA4A+synthetic/opaque==", "eyJ.abc",
+        "opaque..iv.ciphertext.tag", "eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiIxIn0.c2ln"] {
+        assert!(matches!(delegation(raw), Token::Compact(value) if value == format!("d={raw}")));
+    }
+}
+
+#[test]
+fn delegation_ticket_malformed_jwe_keeps_d_prefix() {
+    let valid = jwe(json!({"alg":"dir","enc":"A256GCM"}), "");
+    let mut invalid = vec!["opaque..iv.ciphertext.tag".to_string(), "eyJ..a.b.c".into(),
+        format!("{valid}.extra"), valid.replace("..", ".+."), valid.replace("..", ".=.")];
+    for header in [json!(null), json!([]), json!({}), json!({"alg":"dir"}),
+        json!({"alg":"dir","enc":""}), json!({"alg":17,"enc":"A256GCM"})] {
+        invalid.push(jwe(header, ""));
+    }
+    let mut parts: Vec<_> = valid.split('.').map(str::to_string).collect();
+    for index in [2, 3, 4] {
+        let before = parts[index].clone(); parts[index].clear();
+        invalid.push(parts.join(".")); parts[index] = before;
+    }
+    invalid.push(valid.replace(".", ". "));
+    for raw in invalid {
+        assert!(matches!(delegation(&raw), Token::Compact(value) if value == format!("d={raw}")));
+    }
+}
